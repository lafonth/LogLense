# Secrets
.env
.env.*
!.env.example

# data outputs (top-level only, not src/data/)
/data/

# downloaded game data CSVs (too large to commit; run scripts/fetch-feral-talents.ts to regenerate)
scripts/TraitNodeXTraitNodeEntry.csv
*.csv

# config — the agent definitions, hooks and settings are versioned; the rest is not.
# Config that is not versioned is config that disappears at the next clone.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/hooks/

# prompt download output
ai-prompt.txt

# brouillons et documents de travail — utiles maintenant, sans valeur dans l'historique.
# Ce qui mérite d'être versionné sort de ce dossier ; ce qui y reste est jetable.
scratch/

# skills and agents (restore with: npx skills experimental_install)
.agents
.superpowers

# Next.js
.next/
.next-dev-stub/
out/
node_modules/
next-env.d.ts

# Vercel — `vercel link` écrit ici l'identité du projet de celui qui déploie.
# Elle n'est pas partagée : le CI la reçoit par ses secrets (voir docs/06-deploiement.md).
.vercel/

# Python environment
__pycache__/
*.py[cod]
*$py.class
.venv
venv/
ENV/

# OS files
.DS_Store
desktop.ini
tsconfig.tsbuildinfo
