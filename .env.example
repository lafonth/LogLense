# Warcraft Logs API credentials (required at runtime)
# Register at: https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=your_client_id_here
WCL_CLIENT_SECRET=your_client_secret_here

# NextAuth (required for Battle.net login)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Blizzard Game Data API (only needed to run scripts/fetch-feral-talents.ts)
# Register at: https://develop.battle.net/
BLIZZARD_CLIENT_ID=your_blizzard_client_id_here
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret_here

# Upstash Redis — required for starred favourites and recent characters
# Create a free database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# AI Report — optional server-side keys (skip the UI key input when set)
# If unset, users paste their own key in the UI instead.
# Groq (free tier, recommended): https://console.groq.com/
GROQ_API_KEY=
# Override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=
# Gemini Flash (free tier): https://aistudio.google.com/ — use a personal Gmail account
GEMINI_API_KEY=
# Override the Gemini model (default: gemini-2.0-flash-lite)
GEMINI_MODEL=
# Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
