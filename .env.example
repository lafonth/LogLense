# Warcraft Logs API credentials (required at runtime)
# Register at: https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=your_client_id_here
WCL_CLIENT_SECRET=your_client_secret_here

# Blizzard Game Data API (only needed to run scripts/fetch-feral-talents.ts)
# Register at: https://develop.battle.net/
BLIZZARD_CLIENT_ID=your_blizzard_client_id_here
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret_here

# AI Report — users paste their own key in the UI; no server-side key needed.
