# Warcraft Logs API credentials (required at runtime)
# Register at: https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=your_client_id_here
WCL_CLIENT_SECRET=your_client_secret_here

# NextAuth (required for Battle.net login)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL_DEV=http://localhost:3000
NEXTAUTH_URL_PROD=https://your-app.vercel.app

# Beta guilde fermée — liste d'amorçage, battletags séparés par des virgules
# (ex: "Jumbaa#1234,Autre#1"). Depuis /admin, les admissions courantes se font en base : cette
# liste-ci n'est plus que le filet anti-verrouillage, lue avant Redis pour qu'une base muette
# ne puisse pas enfermer tout le monde dehors. Absente ou vide = fermé à tout le monde, jamais
# ouvert à tout le monde.
BETA_ALLOWLIST=

# Qui administre l'accès sur /admin — battletags séparés par des virgules.
# Volontairement hors base : cette identité est ce qui autorise à écrire dans Redis, l'y lire
# la laisserait s'accorder elle-même. Absente = personne n'atteint /admin, qui répond 404.
ADMIN_BATTLETAGS=

# Blizzard OAuth — register at: https://develop.battle.net/
# Create two separate clients: one for dev (redirect: http://localhost:3000/api/auth/callback/battlenet)
# and one for prod (redirect: https://your-app.vercel.app/api/auth/callback/battlenet)
BLIZZARD_CLIENT_ID_DEV=your_dev_client_id_here
BLIZZARD_CLIENT_SECRET_DEV=your_dev_client_secret_here
BLIZZARD_CLIENT_ID_PROD=your_prod_client_id_here
BLIZZARD_CLIENT_SECRET_PROD=your_prod_client_secret_here

# Upstash Redis — required for starred favourites and recent characters
# Create a free database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# AI — les clés sont les nôtres. Il n'y a plus de champ de clé dans l'interface : le rapport et
# le chat dépensent la clé serveur, sous le plafond horaire de `rate-limit.ts`. Sans clé pour le
# fournisseur offert, les deux surfaces répondent 503.
# Claude: https://console.anthropic.com/ — le seul offert par défaut.
ANTHROPIC_API_KEY=
# Élargit l'offre au-delà de Claude, un nom par entrée parmi claude,gemini,openai,groq. Un nom
# inconnu est ignoré. Le catalogue reste dans le code, mais rien n'en sort sans être nommé ici.
AI_PROVIDERS=
# Groq (free tier): https://console.groq.com/ — rapport seulement, jamais le chat (pas d'outils).
# Le modèle Groq n'a volontairement pas d'override d'environnement : il vient du choix fait dans
# l'interface (voir src/lib/ai/groq.ts).
GROQ_API_KEY=
# Gemini Flash (free tier): https://aistudio.google.com/ — use a personal Gmail account
GEMINI_API_KEY=
# Override the Gemini model (default: gemini-3.5-flash-lite)
GEMINI_MODEL=
# OpenAI: https://platform.openai.com/
OPENAI_API_KEY=

# Dev-only session stub — DO NOT SET IN A DEPLOYED ENVIRONMENT.
# When set to "1" (and only when NODE_ENV is not "production"), this adds a
# NextAuth Credentials provider that signs in as a fake "DevUser#0000" user
# without any Battle.net login. It exists solely so local/CI browser tests
# (e.g. Playwright) can reach the authenticated UI. It bypasses real
# authentication entirely and must never be set in production or on any
# publicly reachable deployment.
ENABLE_DEV_SESSION=

# Label capture — salt for the anonymous user identifier stored with each
# "not comparable" ruling. Any long random string; generate with:
#   openssl rand -hex 32
# Without it the label route refuses to write rather than storing an unsalted
# identifier, which would make the corpus impossible to certify afterwards.
LABEL_SALT=
