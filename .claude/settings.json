{
  "autoCompactWindow": 180000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/session-start.mjs", "timeout": 15 }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/pre-compact.mjs", "timeout": 15 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/pre-tool-read.mjs", "timeout": 10 }]
      }
    ]
  }
}
